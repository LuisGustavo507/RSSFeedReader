@page "/"
@using RSSFeedReader.UI.Services
@inject SubscriptionApiClient ApiClient

<PageTitle>Assinaturas RSS</PageTitle>

<h1>Assinaturas RSS</h1>

<div class="mb-3">
    <label for="urlInput" class="form-label">URL do Feed</label>
    <div class="input-group">
        <input id="urlInput"
               type="url"
               class="form-control"
               placeholder="https://example.com/rss"
               @bind="newUrl"
               @bind:event="oninput" />
        <button class="btn btn-primary"
                @onclick="AddSubscriptionAsync"
                disabled="@(string.IsNullOrWhiteSpace(newUrl) || isLoading)">
            @if (isLoading)
            {
                <span>Adicionando...</span>
            }
            else
            {
                <span>Adicionar</span>
            }
        </button>
    </div>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="text-danger mt-1">@errorMessage</div>
    }
</div>

@if (subscriptions.Count == 0)
{
    <p class="text-muted">Nenhuma assinatura adicionada ainda.</p>
}
else
{
    <ul class="list-group">
        @foreach (var sub in subscriptions)
        {
            <li class="list-group-item">
                <span class="me-2 text-muted">#@sub.Id</span>
                <a href="@sub.Url" target="_blank" rel="noopener noreferrer">@sub.Url</a>
            </li>
        }
    </ul>
}

@code {
    private string newUrl = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private List<Subscription> subscriptions = new();

    protected override async Task OnInitializedAsync()
    {
        subscriptions = await ApiClient.GetSubscriptionsAsync();
    }

    private async Task AddSubscriptionAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;
        try
        {
            var added = await ApiClient.AddSubscriptionAsync(newUrl.Trim());
            if (added is not null)
            {
                subscriptions.Add(added);
                newUrl = string.Empty;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Erro ao adicionar assinatura: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
